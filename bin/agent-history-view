#!/usr/bin/env python3
"""Side pane for Cursor CLI history.

Foot scrollback is empty (the CLI clears it). This reads the conversation
JSONL under ~/.cursor/projects/<abs-path-with-dashes>/agent-transcripts.
"""
from __future__ import annotations

import curses
import json
import locale
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy"
TARGET = CACHE / "agent-history.target"
SELF = Path(__file__).resolve()
HZ = os.sysconf("SC_CLK_TCK")
QUERY_RE = re.compile(
    r"<timestamp>.*?</timestamp>\s*<user_query>\s*(.*?)\s*</user_query>",
    re.DOTALL,
)


def drain_stdin() -> None:
    if sys.stdin.isatty():
        return
    try:
        readable, _, _ = select.select([sys.stdin], [], [], 0.05)
        if readable:
            sys.stdin.read()
    except (OSError, ValueError):
        pass


def cmdline(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(
            "utf-8", "replace"
        )
    except OSError:
        return ""


def children(pid: int) -> list[int]:
    out: list[int] = []
    try:
        for entry in Path("/proc").iterdir():
            if not entry.name.isdigit():
                continue
            try:
                ppid = int(entry.joinpath("stat").read_text().split(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            if ppid == pid:
                out.append(int(entry.name))
    except OSError:
        pass
    return out


def descendants(pid: int) -> list[int]:
    found: list[int] = []
    stack = [pid]
    seen = {pid}
    while stack:
        cur = stack.pop()
        for child in children(cur):
            if child not in seen:
                seen.add(child)
                found.append(child)
                stack.append(child)
    return found


def proc_start(pid: int) -> float | None:
    try:
        uptime = float(Path("/proc/uptime").read_text().split()[0])
        ticks = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19])
        return time.time() - uptime + ticks / HZ
    except (OSError, IndexError, ValueError):
        return None


def agent_cwd(foot_pid: int) -> Path | None:
    for pid in descendants(foot_pid):
        cmd = cmdline(pid)
        if "cursor-agent" not in cmd:
            continue
        if "screenlook" in cmd or "hypruse" in cmd:
            continue
        try:
            return Path(f"/proc/{pid}/cwd").resolve()
        except OSError:
            continue
    return None


def transcripts_dir_for(cwd: Path) -> Path:
    # Cursor slugs the absolute path: /home/user/foo → home-user-foo
    slug = str(cwd.resolve()).lstrip("/").replace("/", "-")
    return Path.home() / ".cursor" / "projects" / slug / "agent-transcripts"


def pick_jsonl(tdir: Path, foot_start: float | None) -> Path | None:
    jsonls = list(tdir.glob("*/*.jsonl"))
    if not jsonls:
        return None
    if foot_start is not None:
        scored: list[tuple[int, float, Path]] = []
        for path in jsonls:
            dt = path.parent.stat().st_ctime - foot_start
            if -5 <= dt <= 180:
                scored.append((0 if dt >= 0 else 1, abs(dt), path))
        if scored:
            scored.sort()
            return scored[0][2]
    return max(jsonls, key=lambda p: p.stat().st_mtime)


def hypr_clients() -> list[dict]:
    try:
        return json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return []


def hypr_active() -> dict:
    try:
        return json.loads(
            subprocess.check_output(["hyprctl", "activewindow", "-j"], text=True)
        )
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return {}


def focused_agent_pid() -> int | None:
    window = hypr_active()
    cls = window.get("class") or ""
    if cls == "org.omarchy.agent":
        return int(window["pid"])
    if cls == "org.omarchy.agent-history":
        workspace = (window.get("workspace") or {}).get("id")
        for client in hypr_clients():
            if client.get("class") == "org.omarchy.agent" and (
                client.get("workspace") or {}
            ).get("id") == workspace:
                return int(client["pid"])
    return None


def discover_jsonl() -> Path | None:
    foot_pid = os.getppid()
    cmd = cmdline(foot_pid)
    if "foot" not in cmd:
        foot_pid = focused_agent_pid() or foot_pid
    cwd = agent_cwd(foot_pid) if foot_pid else None
    if cwd is None:
        cwd = Path.home()
    tdir = transcripts_dir_for(cwd)
    if not tdir.is_dir():
        return None
    return pick_jsonl(tdir, proc_start(foot_pid) if foot_pid else None)


def user_text(raw: str) -> str:
    match = QUERY_RE.search(raw)
    if match:
        return match.group(1).strip()
    return raw.strip()


def render(jsonl: Path) -> str:
    if not jsonl.is_file():
        return f"(file not found: {jsonl})\n"
    blocks: list[str] = []
    try:
        lines = jsonl.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        return f"(cannot read: {exc})\n"
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        role = obj.get("role")
        if role not in ("user", "assistant"):
            continue
        texts: list[str] = []
        for part in (obj.get("message") or {}).get("content") or []:
            if isinstance(part, dict) and part.get("type") == "text":
                chunk = (part.get("text") or "").strip()
                if chunk:
                    texts.append(chunk)
        body = "\n".join(texts).strip()
        if role == "user":
            body = user_text(body)
            if body:
                blocks.append("── you ──\n" + strip_md(body))
        elif body:
            blocks.append("── agent ──\n" + strip_md(body))
    if not blocks:
        return "(conversation still empty)\n"
    return "\n\n".join(blocks) + "\n"


def strip_md(text: str) -> str:
    return re.sub(r"\*\*(.+?)\*\*", r"\1", text)


def wrap_text(text: str, width: int) -> list[str]:
    width = max(16, width)
    out: list[str] = []
    for raw in text.splitlines():
        if not raw:
            out.append("")
            continue
        rest = raw
        while len(rest) > width:
            cut = rest.rfind(" ", 0, width)
            if cut < 8:
                cut = width
            out.append(rest[:cut])
            rest = rest[cut:].lstrip()
        out.append(rest)
    return out or [""]


def read_target() -> Path | None:
    try:
        raw = TARGET.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return Path(raw) if raw else None


def write_target(jsonl: Path) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    TARGET.write_text(str(jsonl) + "\n", encoding="utf-8")


def sidecar_running() -> bool:
    return any(c.get("class") == "org.omarchy.agent-history" for c in hypr_clients())


def close_sidecar() -> None:
    for client in hypr_clients():
        if client.get("class") != "org.omarchy.agent-history":
            continue
        pid = client.get("pid")
        if pid:
            try:
                os.kill(int(pid), 15)
            except OSError:
                pass


def launch_pager() -> None:
    subprocess.Popen(
        [
            "setsid",
            "uwsm-app",
            "--",
            "foot",
            "--app-id=org.omarchy.agent-history",
            "--title=Agent history",
            "-o",
            "pad=0x0",
            "-e",
            str(SELF),
            "--pager",
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def pager(stdscr: curses.window) -> None:
    curses.curs_set(0)
    curses.use_default_colors()
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
    except curses.error:
        pass
    stdscr.timeout(200)
    stdscr.keypad(True)
    offset = 0
    follow = True
    last_target = -1.0
    jsonl = read_target()

    while True:
        h, w = stdscr.getmaxyx()
        body_h = max(1, h - 1)
        try:
            tgt_m = TARGET.stat().st_mtime
        except OSError:
            tgt_m = 0.0
        if tgt_m != last_target:
            jsonl = read_target()
            last_target = tgt_m
        text = (
            render(jsonl)
            if jsonl is not None and jsonl.is_file()
            else "(no transcript)"
        )
        wrapped = wrap_text(text, max(16, w - 1))
        max_off = max(0, len(wrapped) - body_h)
        if follow:
            offset = max_off
        offset = min(max(0, offset), max_off)
        stdscr.erase()
        # Short conversations: pad from the top so the last line sits on the
        # row above the status bar.
        if len(wrapped) < body_h:
            top = body_h - len(wrapped)
            view = wrapped
            row0 = top
        else:
            view = wrapped[offset : offset + body_h]
            row0 = 0
        for i, line in enumerate(view):
            attr = curses.A_BOLD if line.startswith("── ") else curses.A_NORMAL
            try:
                stdscr.addnstr(row0 + i, 0, line[: w - 1].ljust(w - 1), w - 1, attr)
            except curses.error:
                pass
        status = " Agent history   q quit  j/k scroll  g top  G bottom "
        try:
            stdscr.addnstr(h - 1, 0, status[:w].ljust(w), w, curses.A_REVERSE)
        except curses.error:
            pass
        stdscr.refresh()
        key = stdscr.getch()
        if key == -1:
            continue
        if key == curses.KEY_RESIZE:
            follow = True
            continue
        if key in (ord("q"), ord("Q")):
            break
        if key in (ord("j"), curses.KEY_DOWN):
            if offset < max_off:
                offset += 1
                follow = offset >= max_off
        elif key in (ord("k"), curses.KEY_UP):
            if offset > 0 or (len(wrapped) < body_h):
                offset = max(0, offset - 1)
                follow = False
        elif key in (curses.KEY_NPAGE, ord(" ")):
            offset = min(max_off, offset + body_h)
            follow = offset >= max_off
        elif key == curses.KEY_PPAGE:
            offset = max(0, offset - body_h)
            follow = False
        elif key in (ord("g"), curses.KEY_HOME):
            offset = 0
            follow = False
        elif key in (ord("G"), curses.KEY_END):
            offset = max_off
            follow = True
        elif key == curses.KEY_MOUSE:
            try:
                _id, _x, _y, _z, bstate = curses.getmouse()
            except curses.error:
                continue
            if bstate & curses.BUTTON4_PRESSED:
                offset = max(0, offset - 3)
                follow = False
            elif bstate & curses.BUTTON5_PRESSED:
                offset = min(max_off, offset + 3)
                follow = offset >= max_off


def launch_mode() -> int:
    drain_stdin()
    jsonl = discover_jsonl()
    CACHE.mkdir(parents=True, exist_ok=True)
    if jsonl is None:
        fallback = CACHE / "agent-history-empty.txt"
        fallback.write_text("(no Cursor transcript found for this window)\n")
        write_target(fallback)
    else:
        write_target(jsonl)
    close_sidecar()
    time.sleep(0.05)
    launch_pager()
    return 0


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--pager":
        locale.setlocale(locale.LC_ALL, "")
        curses.wrapper(pager)
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--render":
        path = Path(sys.argv[2]) if len(sys.argv) > 2 else discover_jsonl()
        if path is None:
            print("(no transcript)", file=sys.stderr)
            return 1
        sys.stdout.write(render(path))
        return 0
    return launch_mode()


if __name__ == "__main__":
    sys.exit(main())
