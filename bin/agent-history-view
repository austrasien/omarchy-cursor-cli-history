#!/usr/bin/env python3
"""Side pane for Cursor CLI history.

Foot scrollback is empty (the CLI clears it). This reads the conversation
JSONL under ~/.cursor/projects/<abs-path-with-dashes>/agent-transcripts.
"""
from __future__ import annotations

import curses
import difflib
import json
import locale
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy"
TARGET = CACHE / "agent-history.target"
SELF = Path(__file__).resolve()
HZ = os.sysconf("SC_CLK_TCK")
QUERY_RE = re.compile(
    r"<timestamp>.*?</timestamp>\s*<user_query>\s*(.*?)\s*</user_query>",
    re.DOTALL,
)
CONV_UUID_RE = re.compile(
    r"(?:/cursor/chats/[^/]+/|/agent-transcripts/)"
    r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})",
    re.I,
)


def drain_stdin() -> None:
    if sys.stdin.isatty():
        return
    try:
        readable, _, _ = select.select([sys.stdin], [], [], 0.05)
        if readable:
            sys.stdin.read()
    except (OSError, ValueError):
        pass


def cmdline(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(
            "utf-8", "replace"
        )
    except OSError:
        return ""


def children(pid: int) -> list[int]:
    out: list[int] = []
    try:
        for entry in Path("/proc").iterdir():
            if not entry.name.isdigit():
                continue
            try:
                ppid = int(entry.joinpath("stat").read_text().split(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            if ppid == pid:
                out.append(int(entry.name))
    except OSError:
        pass
    return out


def descendants(pid: int) -> list[int]:
    found: list[int] = []
    stack = [pid]
    seen = {pid}
    while stack:
        cur = stack.pop()
        for child in children(cur):
            if child not in seen:
                seen.add(child)
                found.append(child)
                stack.append(child)
    return found


def proc_start(pid: int) -> float | None:
    try:
        uptime = float(Path("/proc/uptime").read_text().split()[0])
        ticks = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19])
        return time.time() - uptime + ticks / HZ
    except (OSError, IndexError, ValueError):
        return None


def agent_cwd(foot_pid: int) -> Path | None:
    for pid in descendants(foot_pid):
        cmd = cmdline(pid)
        if "cursor-agent" not in cmd:
            continue
        if "screenlook" in cmd or "hypruse" in cmd:
            continue
        try:
            return Path(f"/proc/{pid}/cwd").resolve()
        except OSError:
            continue
    return None


def transcripts_dir_for(cwd: Path) -> Path:
    # Cursor slugs the absolute path: /home/austraz/foo → home-austraz-foo
    slug = str(cwd.resolve()).lstrip("/").replace("/", "-")
    return Path.home() / ".cursor" / "projects" / slug / "agent-transcripts"


def conversation_id_for(foot_pid: int) -> str | None:
    ordered: list[int] = []
    for pid in descendants(foot_pid):
        cmd = cmdline(pid)
        if "screenlook" in cmd or "hypruse" in cmd:
            continue
        if "cursor-agent" in cmd:
            ordered.insert(0, pid)
        else:
            ordered.append(pid)
    for pid in ordered:
        fd_dir = Path(f"/proc/{pid}/fd")
        try:
            for entry in fd_dir.iterdir():
                try:
                    target = os.readlink(entry)
                except OSError:
                    continue
                match = CONV_UUID_RE.search(target)
                if match:
                    return match.group(1).lower()
        except OSError:
            pass
        try:
            env = Path(f"/proc/{pid}/environ").read_bytes()
        except OSError:
            continue
        for item in env.split(b"\0"):
            if not item.startswith(b"CURSOR_CONVERSATION_ID="):
                continue
            val = item.split(b"=", 1)[1].decode("ascii", "replace").strip().lower()
            if val:
                return val
    return None


def jsonl_for_id(tdir: Path, conv_id: str) -> Path | None:
    path = tdir / conv_id / f"{conv_id}.jsonl"
    return path if path.is_file() else None


def assign_jsonls(windows: list[dict]) -> dict[str, Path]:
    """One JSONL per live CLI window.

    Prefer the conversation UUID from cursor-agent's open store.db. Newest
    window / latest mtime is a fallback only: an older window that is still
    streaming always looks like the latest JSONL.
    """
    assigned: dict[str, Path] = {}
    by_dir: dict[Path, list[dict]] = {}
    for win in windows:
        by_dir.setdefault(win["tdir"], []).append(win)
    for tdir, group in by_dir.items():
        unused = set(tdir.glob("*/*.jsonl"))
        for win in group:
            conv_id = win.get("conv_id")
            if not conv_id:
                continue
            path = jsonl_for_id(tdir, str(conv_id))
            if path is None or path not in unused:
                continue
            assigned[win["address"]] = path
            unused.discard(path)
        ordered = sorted(
            (w for w in group if w["address"] not in assigned),
            key=lambda w: w["start"] or 0,
            reverse=True,
        )
        for win in ordered:
            start = win["start"]
            candidates: list[tuple[float, Path]] = []
            for path in unused:
                try:
                    mt = path.stat().st_mtime
                except OSError:
                    continue
                if start is not None and mt < start - 5:
                    continue
                candidates.append((mt, path))
            if not candidates:
                continue
            path = max(candidates)[1]
            unused.discard(path)
            assigned[win["address"]] = path
    return assigned


def hypr_clients() -> list[dict]:
    try:
        return json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return []


def hypr_active() -> dict:
    try:
        return json.loads(
            subprocess.check_output(["hyprctl", "activewindow", "-j"], text=True)
        )
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return {}


def focused_agent_pid() -> int | None:
    window = hypr_active()
    cls = window.get("class") or ""
    if cls == "org.omarchy.agent":
        return int(window["pid"])
    if cls == "org.omarchy.agent-history":
        workspace = (window.get("workspace") or {}).get("id")
        for client in hypr_clients():
            if client.get("class") == "org.omarchy.agent" and (
                client.get("workspace") or {}
            ).get("id") == workspace:
                return int(client["pid"])
    return None


def windows_from_hypr() -> list[dict]:
    windows: list[dict] = []
    for client in hypr_clients():
        if client.get("class") != "org.omarchy.agent":
            continue
        address = str(client.get("address") or "")
        try:
            foot_pid = int(client["pid"])
        except (KeyError, TypeError, ValueError):
            continue
        cwd = agent_cwd(foot_pid)
        if cwd is None:
            continue
        tdir = transcripts_dir_for(cwd)
        if not tdir.is_dir():
            continue
        windows.append(
            {
                "address": address,
                "pid": foot_pid,
                "tdir": tdir,
                "start": proc_start(foot_pid),
                "conv_id": conversation_id_for(foot_pid),
            }
        )
    return windows


def discover_jsonl() -> Path | None:
    foot_pid = os.getppid()
    if "foot" not in cmdline(foot_pid):
        foot_pid = focused_agent_pid() or 0
    windows = windows_from_hypr()
    assigned = assign_jsonls(windows)
    for win in windows:
        if win["pid"] == foot_pid:
            path = assigned.get(win["address"])
            if path is not None:
                return path
    cwd = agent_cwd(foot_pid) if foot_pid else None
    if cwd is None:
        cwd = Path.home() / "Documents" / "Obsidian" / "austrobs"
    tdir = transcripts_dir_for(cwd)
    if not tdir.is_dir():
        return None
    jsonls = list(tdir.glob("*/*.jsonl"))
    if not jsonls:
        return None
    return max(jsonls, key=lambda p: p.stat().st_mtime)


def user_text(raw: str) -> str:
    match = QUERY_RE.search(raw)
    if match:
        return match.group(1).strip()
    return raw.strip()


THEME = Path.home() / ".local/state/omarchy/current/theme/colors.toml"
FOOT_HISTORY_INI = Path.home() / ".config/foot/agent-history.ini"
FOOT_CLI_INI = Path.home() / ".config/foot/agent.ini"
FOOT_INI = Path.home() / ".config/foot/foot.ini"

def load_theme() -> dict[str, str]:
    colors = {
        "accent": "#e68e0d",
        "green": "#FFC107",
        "red": "#D35F5F",
        "background": "#121212",
        "foreground": "#bebebe",
        "light_foreground": "#8a8a8d",
        "selection": "#2a2a2a",
        "lighter_background": "#1e1e1e",
        "bright_cyan": "#eaeaea",
    }
    try:
        raw = THEME.read_text(encoding="utf-8")
    except OSError:
        return colors
    for line in raw.splitlines():
        match = re.match(
            r'^\s*(accent|green|red|background|foreground|light_foreground|selection|lighter_background|bright_cyan)\s*=\s*["\']?(#[0-9A-Fa-f]{6})',
            line,
        )
        if match:
            colors[match.group(1)] = match.group(2)
    return colors


def hex_rgb1000(value: str) -> tuple[int, int, int]:
    return (
        int(value[1:3], 16) * 1000 // 255,
        int(value[3:5], 16) * 1000 // 255,
        int(value[5:7], 16) * 1000 // 255,
    )


def mix_hex(fg: str, bg: str, amount: float) -> str:
    def ch(h: str, i: int) -> int:
        return int(h[i : i + 2], 16)

    r = round(ch(fg, 1) * amount + ch(bg, 1) * (1 - amount))
    g = round(ch(fg, 3) * amount + ch(bg, 3) * (1 - amount))
    b = round(ch(fg, 5) * amount + ch(bg, 5) * (1 - amount))
    return f"#{r:02x}{g:02x}{b:02x}"


INLINE = re.compile(r"(\*\*(.+?)\*\*|`([^`]+)`|(https://[^\s]+))")
CODE_TOKEN = re.compile(
    r'(#.*$|//.*$|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|'
    r"\b(?:def|class|return|if|else|elif|for|while|import|from|as|try|except|"
    r"with|yield|pass|break|continue|True|False|None|and|or|not|in|is|lambda|"
    r"async|await|const|let|var|function|export|type|interface|new|this|"
    r"void|int|str|bool|fn|pub|use|mod|struct|enum|match)\b)"
)
DIFF_PREVIEW = 8
CTX_KEEP = 3
QUOTE_CH = "▎"
_LAYOUT_CACHE: tuple | None = None


def short_path(path: str) -> str:
    path = path or ""
    home = str(Path.home())
    if path == home or path.startswith(home + "/"):
        return "~" + path[len(home) :]
    return path


def display_name(path: str) -> str:
    name = Path(path or "").name
    return name or short_path(path)


def clip(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    return text[: max(1, width)]


def wrap_one(text: str, width: int) -> list[str]:
    width = max(8, width)
    if not text:
        return [""]
    out: list[str] = []
    rest = text
    while len(rest) > width:
        cut = rest.rfind(" ", 0, width)
        if cut < 4:
            cut = width
        out.append(rest[:cut])
        rest = rest[cut:].lstrip()
    out.append(rest)
    return out


def wrap_text(text: str, width: int) -> list[str]:
    out: list[str] = []
    for raw in (text or "").splitlines() or [""]:
        if not raw:
            out.append("")
            continue
        out.extend(wrap_one(raw, width))
    return out or [""]


def wrap_spans(
    spans: list[tuple[str, str]], width: int
) -> list[list[tuple[str, str]]]:
    width = max(8, width)
    lines: list[list[tuple[str, str]]] = []
    cur: list[tuple[str, str]] = []
    used = 0

    def flush() -> None:
        nonlocal cur, used
        if cur:
            lines.append(cur)
        cur = []
        used = 0

    for style, text in spans:
        remain = text or ""
        while remain:
            room = width - used
            if room <= 0:
                flush()
                continue
            if len(remain) <= room:
                cur.append((style, remain))
                used += len(remain)
                remain = ""
                continue
            cut = remain.rfind(" ", 0, room)
            if used and cut < 1:
                flush()
                continue
            if cut < max(1, room // 5):
                cut = room
            cur.append((style, remain[:cut]))
            remain = remain[cut:].lstrip()
            flush()
    if cur:
        lines.append(cur)
    return lines or [[]]


def parse_inline(text: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    pos = 0
    for match in INLINE.finditer(text):
        if match.start() > pos:
            out.append(("text", text[pos : match.start()]))
        raw = match.group(0)
        if raw.startswith("**"):
            out.append(("bold", match.group(2) or ""))
        elif raw.startswith("`"):
            out.append(("inline", match.group(3) or ""))
        else:
            out.append(("url", match.group(4) or raw))
        pos = match.end()
    if pos < len(text):
        out.append(("text", text[pos:]))
    return out or [("text", text)]


def highlight_code(line: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    pos = 0
    for match in CODE_TOKEN.finditer(line):
        if match.start() > pos:
            out.append(("code", line[pos : match.start()]))
        tok = match.group(0)
        if tok.startswith("#") or tok.startswith("//"):
            out.append(("muted", tok))
        elif tok[:1] in "\"'":
            out.append(("add_fg", tok))
        else:
            out.append(("keyword", tok))
        pos = match.end()
    if pos < len(line):
        out.append(("code", line[pos:]))
    return out or [("code", line)]


def ns_short(namespace: str) -> str:
    if namespace.startswith("plugin-"):
        bits = namespace.split("-")
        return bits[1] if len(bits) > 1 else namespace
    return namespace or "tool"


def tool_line(name: str, inp: dict) -> tuple[str, str, str]:
    inp = inp if isinstance(inp, dict) else {}
    if name == "Read":
        path = str(inp.get("path") or "")
        norm = path.replace("\\", "/")
        if norm.endswith("SKILL.md") and "/skills" in norm:
            return "tool_ok", "Used", Path(path).parent.name
        label = display_name(path)
        off, lim = inp.get("offset"), inp.get("limit")
        try:
            if off is not None and lim is not None:
                start = int(off)
                label += f" lines {start}-{start + int(lim) - 1}"
            elif off is not None:
                label += f" lines {int(off)}+"
        except (TypeError, ValueError):
            pass
        return "tool_ok", "Read", label
    if name == "Glob":
        pat = inp.get("glob_pattern") or ""
        directory = display_name(str(inp.get("target_directory") or ".")) or "."
        return "tool_ok", "Globbed", f'"{pat}" in {directory}'
    if name == "Grep":
        pat = inp.get("pattern") or ""
        where = display_name(str(inp.get("path") or inp.get("glob") or ""))
        rest = f'"{pat}"'
        if where:
            rest += f" in {where}"
        return "tool_ok", "Grepped", rest
    if name == "Shell":
        cmd = (inp.get("command") or "").strip().splitlines()
        first = cmd[0] if cmd else str(inp.get("description") or "")
        return "tool_shell", "$", first
    if name == "StrReplace":
        return "tool_edit", "Edited", display_name(str(inp.get("path") or ""))
    if name == "Write":
        return "tool_edit", "Wrote", display_name(str(inp.get("path") or ""))
    if name == "GetDynamicTools":
        ns = ns_short(str(inp.get("namespace") or ""))
        return "tool_ok", "Explored", f"available MCP tools {ns}".strip()
    if name == "CallDynamicTool":
        ns = ns_short(str(inp.get("namespace") or ""))
        tool = str(inp.get("toolName") or "")
        return "tool_ok", ns, tool
    return "tool_ok", name, ""


def quote_row(line: str, width: int) -> tuple:
    body = clip(line if line is not None else "", max(1, width - 1))
    return ("spans", [("quote", QUOTE_CH), ("ctx", body)], "")


def diff_rows(old: str, new: str, width: int, nd=None) -> list[tuple]:
    """CLI edit card: quoted equal lines, then a short +/- hunk."""
    old_lines = (old or "").splitlines()
    new_lines = (new or "").splitlines()
    chunks: list[tuple[str, list[str]]] = []
    matcher = difflib.SequenceMatcher(
        a=old_lines, b=new_lines, autojunk=False
    )
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == "equal":
            chunks.append(("equal", old_lines[i1:i2]))
        elif tag == "replace":
            chunks.append(("del", old_lines[i1:i2]))
            chunks.append(("add", new_lines[j1:j2]))
        elif tag == "delete":
            chunks.append(("del", old_lines[i1:i2]))
        elif tag == "insert":
            chunks.append(("add", new_lines[j1:j2]))

    trimmed: list[tuple[str, list[str]]] = []
    last = len(chunks) - 1
    for i, (kind, lines) in enumerate(chunks):
        if kind == "equal" and len(lines) > CTX_KEEP:
            has_before = i > 0
            has_after = i < last
            if has_before and has_after:
                trimmed.append((kind, lines[:1] + lines[-1:]))
            elif has_after:
                trimmed.append((kind, lines[-CTX_KEEP:]))
            else:
                trimmed.append((kind, lines[:CTX_KEEP]))
        else:
            trimmed.append((kind, lines))

    rows: list[tuple] = []
    change_total = sum(len(ls) for k, ls in trimmed if k in ("add", "del"))
    shown_change = 0
    for kind, lines in trimmed:
        if kind == "equal":
            for line in lines:
                rows.append(quote_row(line, width))
            continue
        for line in lines:
            if shown_change >= DIFF_PREVIEW:
                continue
            shown_change += 1
            prefix = "+ " if kind == "add" else "- "
            rows.append((kind, clip(prefix + line, width), ""))
    hidden = max(0, change_total - shown_change)
    if hidden:
        rows.append(
            ("muted", f"  … truncated ({hidden} more lines) · ctrl+r to review", "")
        )
    return rows


def markdown_rows(text: str, width: int) -> list[tuple]:
    rows: list[tuple] = []
    in_fence = False
    for raw in (text or "").splitlines():
        stripped = raw.strip()
        if stripped.startswith("```"):
            in_fence = not in_fence
            lang = stripped[3:].strip()
            if in_fence and lang:
                rows.append(("spans", [("quote", QUOTE_CH), ("muted", lang)], ""))
            continue
        if in_fence:
            inner = max(8, width - 1)
            pieces = wrap_one(raw, inner) if raw else [""]
            for piece in pieces:
                rows.append(
                    (
                        "spans",
                        [("quote", QUOTE_CH)] + highlight_code(piece),
                        "",
                    )
                )
            continue
        if not raw.strip():
            rows.append(("blank", "", ""))
            continue
        quote = re.match(r"^>\s?(.*)$", raw)
        if quote:
            spans = [("quote", QUOTE_CH)] + parse_inline(quote.group(1))
            for line in wrap_spans(spans, width):
                rows.append(("spans", line, ""))
            continue
        heading = re.match(r"^(#{1,6})\s+(.*)$", raw)
        if heading:
            for line in wrap_spans(parse_inline(heading.group(2)), width):
                rows.append(
                    (
                        "spans",
                        [("heading", t) if s == "text" else (s, t) for s, t in line],
                        "",
                    )
                )
            continue
        bullet = re.match(r"^[-*]\s+(.*)$", raw)
        if bullet:
            spans = [("text", "• ")] + parse_inline(bullet.group(1))
            for line in wrap_spans(spans, width):
                rows.append(("spans", line, ""))
            continue
        numbered = re.match(r"^(\d+)\.\s+(.*)$", raw)
        if numbered:
            spans = [("text", f"{numbered.group(1)}. ")] + parse_inline(numbered.group(2))
            for line in wrap_spans(spans, width):
                rows.append(("spans", line, ""))
            continue
        for line in wrap_spans(parse_inline(raw), width):
            rows.append(("spans", line, ""))
    return rows


def iter_parts(jsonl: Path) -> list[tuple]:
    rows: list[tuple] = []
    try:
        lines = jsonl.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        return [("text", f"(lecture impossible: {exc})")]
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        role = obj.get("role")
        if role not in ("user", "assistant"):
            continue
        for part in (obj.get("message") or {}).get("content") or []:
            if not isinstance(part, dict):
                continue
            ptype = part.get("type")
            if ptype == "text":
                chunk = (part.get("text") or "").strip()
                if not chunk:
                    continue
                if role == "user":
                    body = user_text(chunk)
                    if body:
                        rows.append(("user", body))
                else:
                    rows.append(("assistant", chunk))
            elif ptype == "tool_use" and role == "assistant":
                rows.append(("tool", part.get("name") or "tool", part.get("input") or {}))
    return rows


def append_blank(rows: list) -> None:
    if rows and rows[-1][0] != "blank":
        rows.append(("blank", "", ""))


def layout_rows(jsonl: Path | None, width: int) -> list[tuple]:
    global _LAYOUT_CACHE
    width = max(16, width)
    if jsonl is None or not jsonl.is_file():
        return [("text", "(pas de transcript)", "")]
    try:
        st = jsonl.stat()
        key = (str(jsonl), st.st_mtime, st.st_size, width)
    except OSError:
        return [("text", "(pas de transcript)", "")]
    if _LAYOUT_CACHE and _LAYOUT_CACHE[0] == key:
        return _LAYOUT_CACHE[1]

    events = iter_parts(jsonl)
    rows: list[tuple] = []
    last = ""
    read_batch: list[tuple[str, str, str]] = []

    def flush_reads() -> None:
        if not read_batch:
            return
        if len(read_batch) >= 2:
            rows.append(("tool_ok", "Read", f"{len(read_batch)} files"))
        rows.extend(read_batch)
        read_batch.clear()

    for event in events:
        kind = event[0]
        if kind == "user":
            flush_reads()
            append_blank(rows)
            inner = max(8, width - 2)
            for line in wrap_text(event[1], inner):
                rows.append(("user_body", f" {line}" if line else "", ""))
            last = "user"
        elif kind == "assistant":
            flush_reads()
            if last in ("user", "assistant"):
                append_blank(rows)
            rows.extend(markdown_rows(event[1], width))
            last = "assistant"
        elif kind == "tool":
            if last == "user":
                append_blank(rows)
            name = event[1]
            inp = event[2] if len(event) > 2 else {}
            if not isinstance(inp, dict):
                inp = {}
            tkind, verb, rest = tool_line(name, inp)
            extra = rest
            drows: list[tuple] = []
            if name == "Read":
                read_batch.append((tkind, verb, rest))
                last = "tool"
                continue
            flush_reads()
            if name == "StrReplace":
                old_s = inp.get("old_string") or ""
                new_s = inp.get("new_string") or ""
                nd = list(difflib.ndiff(old_s.splitlines(), new_s.splitlines()))
                drows = diff_rows(old_s, new_s, max(8, width - 1), nd)
                plus = sum(1 for ln in nd if ln.startswith("+ "))
                minus = sum(1 for ln in nd if ln.startswith("- "))
                bits = [rest]
                if plus:
                    bits.append(f"+{plus}")
                if minus:
                    bits.append(f"-{minus}")
                extra = "  ".join(x for x in bits if x)
            rows.append((tkind, verb, extra))
            if name == "StrReplace":
                rows.extend(drows)
            elif name == "Write":
                contents = inp.get("contents") or ""
                lines = contents.splitlines()
                preview = lines[:DIFF_PREVIEW]
                for line in preview:
                    rows.append(("add", clip("+ " + line, max(8, width - 1)), ""))
                more = max(0, len(lines) - len(preview))
                if more:
                    rows.append(
                        (
                            "muted",
                            f"  … truncated ({more} more lines) · ctrl+r to review",
                            "",
                        )
                    )
            last = "tool"
    flush_reads()
    if not rows:
        rows = [("text", "(conversation encore vide)", "")]
    _LAYOUT_CACHE = (key, rows)
    return rows


def render(jsonl: Path) -> str:
    chunks: list[str] = []
    for row in layout_rows(jsonl, 100):
        kind = row[0]
        if kind == "blank":
            chunks.append("")
        elif kind == "spans":
            chunks.append("".join(t for _, t in row[1]))
        elif kind in ("tool_ok", "tool_edit", "tool_shell"):
            chunks.append(f"{row[1]}  {row[2]}".rstrip())
        else:
            chunks.append(str(row[1]))
    return "\n".join(chunks) + "\n"


def setup_colors() -> dict[str, int]:
    curses.start_color()
    curses.use_default_colors()
    fallback = {
        "user_text": curses.A_REVERSE,
        "text": curses.A_NORMAL,
        "bold": curses.A_BOLD,
        "heading": curses.A_BOLD,
        "muted": curses.A_DIM,
        "inline": curses.A_BOLD,
        "url": curses.A_UNDERLINE,
        "keyword": curses.A_BOLD,
        "code": curses.A_NORMAL,
        "tool_ok": curses.A_BOLD,
        "tool_edit": curses.A_BOLD,
        "add": curses.A_BOLD,
        "del": curses.A_BOLD,
        "add_fg": curses.A_BOLD,
        "del_fg": curses.A_BOLD,
        "muted_add": curses.A_DIM,
        "muted_del": curses.A_DIM,
        "ctx": curses.A_DIM,
        "quote": curses.A_BOLD,
        "status": curses.A_REVERSE,
    }
    try:
        theme = load_theme()
        gold = theme.get("green") or "#FFC107"
        body = theme.get("foreground") or "#bebebe"
        add_fg = "#8fbc9a"
        del_fg = "#c47a7a"
        ink_blue = "#6ea8fe"
        bg = theme.get("background") or "#121212"
        if curses.can_change_color() and curses.COLORS >= 29:
            curses.init_color(16, *hex_rgb1000(theme["accent"]))
            curses.init_color(17, *hex_rgb1000(gold))
            curses.init_color(18, *hex_rgb1000(bg))
            curses.init_color(19, *hex_rgb1000(body))
            curses.init_color(20, *hex_rgb1000(theme.get("selection") or "#2a2a2a"))
            curses.init_color(21, *hex_rgb1000(theme["light_foreground"]))
            curses.init_color(22, *hex_rgb1000(del_fg))
            curses.init_color(23, *hex_rgb1000(add_fg))
            curses.init_color(24, *hex_rgb1000(mix_hex(add_fg, bg, 0.22)))
            curses.init_color(25, *hex_rgb1000(mix_hex(del_fg, bg, 0.20)))
            curses.init_color(26, *hex_rgb1000(theme.get("bright_cyan") or "#eaeaea"))
            curses.init_color(27, *hex_rgb1000(theme.get("lighter_background") or "#1e1e1e"))
            curses.init_color(28, *hex_rgb1000(ink_blue))
            curses.init_pair(1, 21, 20)
            curses.init_pair(2, 19, 18)
            curses.init_pair(3, 17, 18)
            curses.init_pair(4, 17, 18)
            curses.init_pair(5, 21, 18)
            curses.init_pair(6, 23, 24)
            curses.init_pair(7, 22, 25)
            curses.init_pair(8, 26, 18)
            curses.init_pair(9, 19, 27)
            curses.init_pair(10, 28, 18)
            curses.init_pair(11, 16, 27)
            curses.init_pair(12, 28, 18)
            curses.init_pair(13, 23, 18)
            curses.init_pair(14, 22, 18)
            curses.init_pair(15, 21, 24)
            curses.init_pair(16, 21, 25)
        else:
            for i, (fg, bgc) in enumerate(
                [
                    (curses.COLOR_WHITE, curses.COLOR_BLACK),
                    (curses.COLOR_WHITE, -1),
                    (curses.COLOR_YELLOW, -1),
                    (curses.COLOR_YELLOW, -1),
                    (curses.COLOR_WHITE, -1),
                    (curses.COLOR_GREEN, -1),
                    (curses.COLOR_RED, -1),
                    (curses.COLOR_WHITE, -1),
                    (curses.COLOR_WHITE, -1),
                    (curses.COLOR_CYAN, -1),
                    (curses.COLOR_YELLOW, -1),
                    (curses.COLOR_CYAN, -1),
                    (curses.COLOR_GREEN, -1),
                    (curses.COLOR_RED, -1),
                    (curses.COLOR_WHITE, -1),
                    (curses.COLOR_WHITE, -1),
                ],
                start=1,
            ):
                curses.init_pair(i, fg, bgc)
        return {
            "user_text": curses.color_pair(1),
            "text": curses.color_pair(2),
            "bold": curses.color_pair(8) | curses.A_BOLD,
            "heading": curses.color_pair(8) | curses.A_BOLD,
            "muted": curses.color_pair(5),
            "inline": curses.color_pair(12),
            "url": curses.color_pair(12) | curses.A_UNDERLINE,
            "keyword": curses.color_pair(10) | curses.A_BOLD,
            "code": curses.color_pair(9),
            "tool_ok": curses.color_pair(3) | curses.A_BOLD,
            "tool_edit": curses.color_pair(4) | curses.A_BOLD,
            "add": curses.color_pair(6),
            "del": curses.color_pair(7),
            "add_fg": curses.color_pair(13),
            "del_fg": curses.color_pair(14),
            "muted_add": curses.color_pair(15),
            "muted_del": curses.color_pair(16),
            "ctx": curses.color_pair(5),
            "quote": curses.color_pair(5) | curses.A_BOLD,
            "status": curses.color_pair(2) | curses.A_REVERSE,
        }
    except curses.error:
        return fallback


def add_seg(
    stdscr: curses.window, y: int, x: int, text: str, attr: int, width: int
) -> int:
    if x >= width or not text:
        return x
    chunk = text[: max(0, width - x)]
    try:
        stdscr.addnstr(y, x, chunk, len(chunk), attr)
    except curses.error:
        if len(chunk) > 1:
            try:
                stdscr.addnstr(y, x, chunk[:-1], len(chunk) - 1, attr)
            except curses.error:
                pass
    return x + len(chunk)


def paint(stdscr: curses.window, y: int, text: str, width: int, attr: int) -> None:
    padded = (text or "").ljust(width)[:width]
    try:
        stdscr.addnstr(y, 0, padded, width, attr)
    except curses.error:
        if width > 1:
            try:
                stdscr.addnstr(y, 0, padded[: width - 1], width - 1, attr)
            except curses.error:
                pass


def paint_spans(
    stdscr: curses.window,
    y: int,
    width: int,
    spans: list[tuple[str, str]],
    colors: dict[str, int],
    fill: str = "text",
) -> None:
    paint(stdscr, y, "", width, colors.get(fill, colors["text"]))
    x = 0
    for style, text in spans:
        x = add_seg(stdscr, y, x, text, colors.get(style, colors["text"]), width)


def paint_tool(
    stdscr: curses.window,
    y: int,
    width: int,
    verb: str,
    rest: str,
    colors: dict[str, int],
    verb_key: str,
) -> None:
    paint(stdscr, y, "", width, colors["text"])
    x = add_seg(stdscr, y, 0, f" {verb}", colors[verb_key], width)
    for part in (rest or "").split("  "):
        if not part:
            continue
        token = part.strip()
        if token.startswith("+") and token[1:].isdigit():
            attr = colors.get("add_fg", colors["add"])
        elif token.startswith("-") and token[1:].isdigit():
            attr = colors.get("del_fg", colors["del"])
        else:
            attr = colors["muted"]
        x = add_seg(stdscr, y, x, "  " + part, attr, width)


def paint_diff(
    stdscr: curses.window,
    y: int,
    width: int,
    body: str,
    kind: str,
    colors: dict[str, int],
) -> None:
    fill = colors[kind]
    comment = colors.get("muted_add" if kind == "add" else "muted_del", colors["muted"])
    paint(stdscr, y, "", width, fill)
    prefix = body[:2] if body[:2] in ("+ ", "- ", "  ") else ""
    rest = body[len(prefix) :]
    x = add_seg(stdscr, y, 0, prefix, fill, width)
    stripped = rest.lstrip()
    if stripped.startswith("#") or stripped.startswith("//"):
        add_seg(stdscr, y, x, rest, comment, width)
        return
    hash_at = rest.find(" #")
    slash_at = rest.find(" //")
    cut = -1
    if hash_at >= 0:
        cut = hash_at
    if slash_at >= 0 and (cut < 0 or slash_at < cut):
        cut = slash_at
    if cut >= 0:
        x = add_seg(stdscr, y, x, rest[:cut], fill, width)
        add_seg(stdscr, y, x, rest[cut:], comment, width)
        return
    add_seg(stdscr, y, x, rest, fill, width)


def paint_row(stdscr, y: int, row: tuple, width: int, colors: dict[str, int]) -> None:
    kind = row[0]
    if kind == "user_body":
        paint(stdscr, y, row[1], width, colors["user_text"])
    elif kind == "spans":
        paint_spans(stdscr, y, width, row[1], colors)
    elif kind == "tool_ok":
        paint_tool(stdscr, y, width, row[1], row[2], colors, "tool_ok")
    elif kind == "tool_edit":
        paint_tool(stdscr, y, width, row[1], row[2], colors, "tool_ok")
    elif kind == "tool_shell":
        paint_tool(stdscr, y, width, row[1], row[2], colors, "tool_ok")
    elif kind in ("add", "del"):
        paint_diff(stdscr, y, width, row[1], kind, colors)
    elif kind in ("ctx", "muted", "heading", "code"):
        paint(stdscr, y, row[1], width, colors[kind])
    elif kind == "blank":
        paint(stdscr, y, "", width, colors["text"])
    else:
        paint(stdscr, y, str(row[1]), width, colors["text"])
def read_target() -> Path | None:
    try:
        raw = TARGET.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return Path(raw) if raw else None


def write_target(jsonl: Path) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    TARGET.write_text(str(jsonl) + "\n", encoding="utf-8")


def sidecar_running() -> bool:
    return any(c.get("class") == "org.omarchy.agent-history" for c in hypr_clients())


def close_sidecar() -> None:
    for client in hypr_clients():
        if client.get("class") != "org.omarchy.agent-history":
            continue
        pid = client.get("pid")
        if pid:
            try:
                os.kill(int(pid), 15)
            except OSError:
                pass


def launch_pager() -> None:
    config = next(
        (p for p in (FOOT_HISTORY_INI, FOOT_CLI_INI, FOOT_INI) if p.is_file()),
        None,
    )
    cmd = [
        "setsid",
        "uwsm-app",
        "--",
        "foot",
    ]
    if config is not None:
        cmd.append(f"--config={config}")
    cmd.extend(
        [
            "--app-id=org.omarchy.agent-history",
            "--title=Agent history",
            "-o",
            "pad=14x14",
            "-e",
            str(SELF),
            "--pager",
        ]
    )
    subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def pager(stdscr: curses.window) -> None:
    curses.curs_set(0)
    colors = setup_colors()
    stdscr.bkgd(" ", colors["text"])
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
    except curses.error:
        pass
    stdscr.timeout(200)
    stdscr.keypad(True)
    offset = 0
    follow = True
    last_target = -1.0
    jsonl = read_target()

    while True:
        h, w = stdscr.getmaxyx()
        body_h = max(1, h - 1)
        col_w = max(16, w)
        try:
            tgt_m = TARGET.stat().st_mtime
        except OSError:
            tgt_m = 0.0
        if tgt_m != last_target:
            jsonl = read_target()
            last_target = tgt_m
        wrapped = layout_rows(jsonl, max(16, w - 1))
        max_off = max(0, len(wrapped) - body_h)
        if follow:
            offset = max_off
        offset = min(max(0, offset), max_off)
        stdscr.erase()
        # Short conversations: pad from the top so the last line sits on the
        # row above the status bar.
        if len(wrapped) < body_h:
            top = body_h - len(wrapped)
            view = wrapped
            row0 = top
        else:
            view = wrapped[offset : offset + body_h]
            row0 = 0
        for i, row in enumerate(view):
            paint_row(stdscr, row0 + i, row, col_w, colors)
        status = " Agent history   q quit  j/k scroll  g haut  G bas "
        paint(stdscr, h - 1, status, col_w, colors["status"])
        stdscr.refresh()
        key = stdscr.getch()
        if key == -1:
            continue
        if key == curses.KEY_RESIZE:
            follow = True
            continue
        if key in (ord("q"), ord("Q")):
            break
        if key in (ord("j"), curses.KEY_DOWN):
            if offset < max_off:
                offset += 1
                follow = offset >= max_off
        elif key in (ord("k"), curses.KEY_UP):
            if offset > 0 or (len(wrapped) < body_h):
                offset = max(0, offset - 1)
                follow = False
        elif key in (curses.KEY_NPAGE, ord(" ")):
            offset = min(max_off, offset + body_h)
            follow = offset >= max_off
        elif key == curses.KEY_PPAGE:
            offset = max(0, offset - body_h)
            follow = False
        elif key in (ord("g"), curses.KEY_HOME):
            offset = 0
            follow = False
        elif key in (ord("G"), curses.KEY_END):
            offset = max_off
            follow = True
        elif key == curses.KEY_MOUSE:
            try:
                _id, _x, _y, _z, bstate = curses.getmouse()
            except curses.error:
                continue
            if bstate & curses.BUTTON4_PRESSED:
                offset = max(0, offset - 3)
                follow = False
            elif bstate & curses.BUTTON5_PRESSED:
                offset = min(max_off, offset + 3)
                follow = offset >= max_off


def launch_mode() -> int:
    drain_stdin()
    jsonl = discover_jsonl()
    CACHE.mkdir(parents=True, exist_ok=True)
    if jsonl is None:
        fallback = CACHE / "agent-history-empty.txt"
        fallback.write_text("(pas de transcript Cursor trouvé pour cette fenêtre)\n")
        write_target(fallback)
    else:
        write_target(jsonl)
    close_sidecar()
    time.sleep(0.05)
    launch_pager()
    return 0


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--pager":
        locale.setlocale(locale.LC_ALL, "")
        curses.wrapper(pager)
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--render":
        path = Path(sys.argv[2]) if len(sys.argv) > 2 else discover_jsonl()
        if path is None:
            print("(pas de transcript)", file=sys.stderr)
            return 1
        sys.stdout.write(render(path))
        return 0
    return launch_mode()


if __name__ == "__main__":
    sys.exit(main())
